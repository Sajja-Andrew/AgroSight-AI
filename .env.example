# ═══════════════════════════════════════════════════════════════
# AgroSight AI — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real secrets.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Application ──
APP_ENV=production
PORT=8080
LOG_LEVEL=INFO

# ── Security ──
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# ── CORS ──
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# ── Database (PostgreSQL for production) ──
POSTGRES_DB=agrosight
POSTGRES_USER=agrosight
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://agrosight:change-me-in-production@postgres:5432/agrosight

# ── Gunicorn ──
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEP_ALIVE=5

# ── MinIO Object Storage ──
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=agrosight
MINIO_SECRET_KEY=change-me-in-production
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_FEEDBACK=feedback

# ── Redis Cache ──
REDIS_URL=redis://redis:6379/0

# ── Model Paths (Docker paths) ──
MODEL_PATH=/app/saved_models/best_model.keras
CLASS_INDICES_PATH=/app/saved_models/class_indices.json
DISEASE_INFO_PATH=/app/saved_models/disease_info.json
LEAF_DETECTOR_PATH=/app/saved_models/leaf_detector.keras
LEAF_DETECTOR_CONFIG=/app/saved_models/leaf_detector_config.json
PYTORCH_MODEL_DIR=/app/saved_models_pytorch

# ── Uploads ──
UPLOAD_FOLDER=/app/backend/uploads
MAX_CONTENT_LENGTH=16777216

# ── Rate Limiting ──
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_ANALYZE=30 per minute

# ── Security ──
ENABLE_SECURE_HEADERS=true
ENABLE_RATE_LIMITING=true

# ── Admin Seed ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@agrosight.ai
ADMIN_PASSWORD=adminpass123

# ── AI Chat ──
ENABLE_AI_CHAT=true

# ── Email / Notifications (optional) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# ADMIN_EMAIL=admin@agrosight.ai
